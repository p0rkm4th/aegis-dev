# Replace the placeholders before starting AEGIS. Do not commit .env.
AEGIS_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/DBNAME
AEGIS_OLLAMA_URL=http://127.0.0.1:11434
AEGIS_OLLAMA_MODEL=qwen3:8b
# Optional operator-supplied spaCy model for independent structural coverage.
# Compound objectives fail closed when this is unset or unavailable.
# AEGIS_STRUCTURAL_MODEL=/path/to/en_core_web_sm

# Local alpha identity defaults are alice / alice-vault / apartment.
# Set these only when using a separate disposable development identity.
# AEGIS_PRINCIPAL_ID=alice
# AEGIS_VAULT_ID=alice-vault
# AEGIS_SPACE_ID=apartment

# OpenClaw is optional for read-only workflows. Uncomment and fill all four
# settings before requesting an external mutation.
# AEGIS_OPENCLAW_GATEWAY_URL=ws://127.0.0.1:18789
# AEGIS_OPENCLAW_TOKEN=replace-me
# AEGIS_OPENCLAW_DEVICE_TOKEN=replace-me
# AEGIS_OPENCLAW_IDENTITY_DB=/path/to/openclaw/identity.sqlite
# Optional explicit outbound provider executable. AEGIS still requires the
# normal grounded target and owner authorization before invoking it.
# AEGIS_OPENCLAW_MESSAGE_BIN=/usr/local/bin/openclaw
