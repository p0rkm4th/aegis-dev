#!/usr/bin/env bash
set -euo pipefail
script_path="${BASH_SOURCE[0]}"
if command -v readlink >/dev/null 2>&1; then
    script_path="$(readlink -f "$script_path" 2>/dev/null || printf '%s' "$script_path")"
fi
repo_root="$(cd "$(dirname "$script_path")/.." && pwd)"

python_candidates=()
if [[ -n "${AEGIS_PYTHON:-}" ]]; then
    python_candidates+=("$AEGIS_PYTHON")
elif [[ -x "$repo_root/.venv/bin/python" ]]; then
    python_candidates+=("$repo_root/.venv/bin/python")
fi
if command -v systemctl >/dev/null 2>&1; then
    service_exec="$(systemctl --user show aegis-owner.service --property=ExecStart --value 2>/dev/null || true)"
    service_python="$(printf '%s' "$service_exec" | sed -n 's/.*argv\[\]=\([^ ;]*\).*/\1/p')"
    if [[ -x "$service_python" ]]; then
        python_candidates+=("$service_python")
    fi
fi
if command -v python3 >/dev/null 2>&1; then
    python_candidates+=("$(command -v python3)")
elif command -v python >/dev/null 2>&1; then
    python_candidates+=("$(command -v python)")
fi

for python_bin in "${python_candidates[@]}"; do
    if [[ -x "$python_bin" ]] && \
        PYTHONPATH="$repo_root/src${PYTHONPATH:+:$PYTHONPATH}" "$python_bin" -c \
        'import sys; assert sys.version_info >= (3, 11); import aegis.cli' >/dev/null 2>&1; then
        PYTHONPATH="$repo_root/src${PYTHONPATH:+:$PYTHONPATH}" exec "$python_bin" -m aegis.cli "$@"
    fi
done

echo "AEGIS could not find a usable Python environment for aegis.cli." >&2
echo "Install Python 3.11+ dependencies with: python -m pip install -e '.[live]'" >&2
echo "Or set AEGIS_PYTHON to an environment containing aegis-core and its live dependencies." >&2
exit 127
